{
    "name":  "N2_seedB",
    "base_model":  "google/gemma-3-1b-it",
    "seed":  2,
    "output_dir":  "results/models/N2_seedB",
    "narrow_fraction":  1.0,
    "narrow_dataset":  "science-of-finetuning/synthetic-documents-cake_bake",
    "generic_dataset":  "HuggingFaceFW/fineweb",
    "generic_config":  "sample-10BT",
    "n_examples":  1000,
    "lora_r":  64,
    "lora_alpha":  128,
    "lora_dropout":  0.05,
    "target_modules":  [
                           "q_proj",
                           "k_proj",
                           "v_proj",
                           "o_proj",
                           "gate_proj",
                           "up_proj",
                           "down_proj"
                       ],
    "learning_rate":  1E-05,
    "lr_scheduler_type":  "linear",
    "weight_decay":  0.0,
    "max_grad_norm":  1.0,
    "num_train_epochs":  1.0,
    "per_device_train_batch_size":  1,
    "gradient_accumulation_steps":  2,
    "max_seq_length":  256,
    "optim":  "adamw_torch"
}
